<mujoco>
	<worldbody>
		<light directional="false" diffuse=".5 .5 .5" pos="0 0 1" dir="0 0 -1"/>
		<!-- Define the plane of the simulation environment -->
		<geom type="plane" size="0 0 0.03" material="matplane"/>
		<!-- Define the position of main body box -->

		<body name="servo_horn" pos="0.0136 -0.0055 0.1">
			<joint name="thigh_joint" pos="0 0 0.0064" ref="0" damping="0.75"/>
			<geom name="servo_link_1" type="cylinder" mass=".001" fromto="0.002 0 0.0064 -0.002 0 0.0064" size="0.0025" rgba=".9 .1 .1 1"/>
			<geom name="servo_horn" mass=".001" type="capsule" fromto="0 0 0.0064 0 0 0.0182" size="0.002" rgba=".9 .9 .9 1"/>
			<body name="thigh_up_link_1" pos="0 0 0.0182">
				<geom name="thigh_up_link_1" type="cylinder" mass=".001" fromto="-0.002 0 0 0.002 0 0" size="0.0025" rgba=".9 .1 .1 1" />
			</body>

		</body>

		<body name="main_leg" pos="0 0 0.1">
			<geom name="hip_box" mass=".001" type="box" size=".0091 .014 .014" rgba="0 .9 0 1"/>
			<geom name="thigh_link" mass="0.001" type="capsule" fromto="0.0086 -0.0055 0.0064 0.0136 -0.0055 0.0064" size="0.002" rgba="0 .9 0 1"/>
			<geom name="leg_servo_link" mass="0.001" type="capsule" fromto="0.0086 -0.0055 -0.0064 0.0136 -0.0055 -0.0064" size="0.002" rgba="0 .9 0 1"/>
			
			<body name="thigh_down" pos="0.0136 -0.0055 -0.0064">
				<geom name="thigh_down" mass=".001" type="capsule" fromto="0 0 0 0 0.031 0" size="0.002" rgba=".9 .9 .9 1"/>

				<joint name="leg_joint" pos="0 0 0" ref="0" damping="0.75"/>
				<site name="leg_link" pos="0 0 0" size="0.003" rgba=".5 .5 .8 1"/>
				<geom name="servo_link_2" type="cylinder" mass=".001" fromto="0.002 0 0 -0.002 0 0" size="0.0025" rgba=".9 .1 .1 1"/>
				<geom name="foot_link" type="cylinder" mass=".001" fromto="0.002 0.031 0 -0.002 0.031 0" size="0.0025" rgba=".9 .1 .1 1"/>

				<body name="foot" pos="0 0.031 0" euler="-29.168 0 0">
					<joint name="knee_down" pos="0 0 0"/>
					<geom name="foot_down" mass=".001" type="capsule" fromto="0 0 0.015 0 0 -0.035" size="0.002" rgba=".9 .9 .9 1"/>
					<geom name="ankle" type="cylinder" mass=".001" fromto="0.0025 0 -0.035 -0.0025 0 -0.035" size="0.0025" rgba=".9 .1 .1 1"/>
					<site name="ankle" pos="0 0 -0.035" size="0.003" rgba=".8 .1 .8 1"/>
					<geom name="knee_up_0" type="cylinder" mass=".001" fromto="0.002 0 0.015 -0.002 0 0.015" size="0.0025" rgba=".9 .1 .1 1"/>
					
					<body name="thigh_up" pos="0.004 0 0.015" euler="12.4566 0 0">
						<joint name="knee_up" pos="0 0 0"/>
						<geom name="thigh_up" mass=".001" type="capsule" fromto="0 0 0 0 -0.040 0" size="0.002" rgba=".9 .9 .9 1"/>
						<geom name="knee_up_1" type="cylinder" mass=".001" fromto="0.002 0 0 -0.002 0 0" size="0.0025" rgba=".9 .9 .1 1"/>

						<body name="thigh_up_link_2" pos="0 -0.040 0">
							<geom name="thigh_up_link_2" type="cylinder" mass=".001" fromto="-0.002 0 0 0.002 0 0" size="0.0025" rgba=".9 .9 .1 1" />
							<!--<joint name="thigh_up_link" pos="0 0 0"/>-->
						</body>
					</body>
				</body>
			</body>
		</body>
		<site name="check" pos="0.0136 -0.0055 0.1182" size="0.003" rgba=".8 .1 .8 0"/>
	</worldbody>

	
	<equality>
		
		<connect anchor="0 0 0" body1="thigh_up_link_1" body2="thigh_up_link_2" active="true" name="equality_constraint"/>
		
		<!--<weld body1="thigh_up_link_1" body2="thigh_up_link_2" relpose="0 0 0 1 0 0 0" active="true" name="equality_constraint"/>-->
	</equality>

</mujoco>